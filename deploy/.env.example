# Copy to deploy/.env and replace every placeholder. deploy/.env is gitignored.
# Owner of the tables; used only by the migrate service and the db container.
POSTGRES_PASSWORD=change-me-owner
# Password of the qo_web role (the web container).
QO_WEB_PASSWORD=change-me-web
# Password of the qo_admin role: the admin service's only database login (and migrate sets it).
QO_ADMIN_PASSWORD=change-me-admin
# Admin service: HMAC key for its CSRF tokens and throttle keys, separate from QO_SECRET so the
# two services share no key. At least 32 random characters; the placeholder is deliberately too
# short, so the admin container refuses to start with it.
QO_ADMIN_SECRET=change-me-admin-secret
# Admin service: its public address (its own hostname); https unless QO_COOKIE_SECURE=false.
QO_ADMIN_BASE_URL=https://admin.quoteops.example.com
# Admin service: absolute session lifetime in hours (1 to 24), never extended.
# QO_ADMIN_SESSION_HOURS=8
# Admin service: sign-in attempts per address and per network in QO_LOGIN_WINDOW_SECONDS (900)
# before a block of QO_LOGIN_BLOCK_SECONDS (900). The address limit locks out the real
# administrator too; reset-admin on the server does not lift it, waiting does.
# QO_ADMIN_LOGIN_FAILS_PER_EMAIL=5
# QO_ADMIN_LOGIN_FAILS_PER_IP=20
# Web: HMAC key for mail links, CSRF tokens and throttle keys. At least 32 random characters,
# for example the output of: python3 -c "import secrets; print(secrets.token_urlsafe(48))".
# The placeholder is deliberately too short, so the web container refuses to start with it.
QO_SECRET=change-me
# Web: the public address; every link in mail starts with it. https unless QO_COOKIE_SECURE=false.
QO_BASE_URL=https://quoteops.example.com
# Web: false only for local http development.
QO_COOKIE_SECURE=true
# Web: header with the client address set by the proxy (CF-Connecting-IP behind Cloudflare);
# empty means the socket address. Never name a header the client can set unchecked.
QO_CLIENT_IP_HEADER=
# Web: the mail backend, file (the default: one file per mail, development and tests) or graph
# (Microsoft Graph). QO_MAIL=graph is set only on the production server. The four Graph values
# below come from ~/.config/quoteops/graph.env on that server; copy them into deploy/.env there
# and never commit them. They may stay empty only while QO_MAIL=file. Only the web service gets
# them, never admin or migrate.
QO_MAIL=file
# Web, graph only: the Entra tenant and application (client) ids, both GUIDs.
QO_GRAPH_TENANT=
QO_GRAPH_CLIENT_ID=
# Web, graph only: the application's client secret (at most 256 characters, no spaces).
QO_GRAPH_CLIENT_SECRET=change-me-graph-secret
# Web, graph only: the sender's user principal name, the shared mailbox the application access
# policy allows (not necessarily the address people see).
QO_MAIL_FROM=quoteops@example.com
# Web: global cap on verified companies (PRD section 6). An unverified sign-up does not count;
# the cap is checked when the mailbox owner opens the link and sets the password.
QO_MAX_COMPANIES=20
# Web: unverified sign-ups are deleted after this many hours (49 to 8760; above the 48-hour
# lifetime of the verification link).
# QO_UNVERIFIED_MAX_AGE_HOURS=72
# Web: and beyond this many newest unverified sign-ups, the oldest first (10 to 1000000).
# QO_UNVERIFIED_KEEP=500
# Web: sign-up mails per address per hour; more are answered the same but not sent.
# QO_SIGNUP_PER_EMAIL=3
# Web: password hashes computed at once in the process. Each needs 32 MiB, so 3 is about 100 MB
# of the 512 MiB container limit; raise it only together with mem_limit in compose.yaml.
# QO_SCRYPT_CONCURRENCY=3
# Web: seconds a sign-in, sign-up or reset waits for a free slot; then it answers 503 "busy".
# QO_SCRYPT_WAIT_SECONDS=8
# Web: users per company, counting pending invitations (PRD section 6; 1 to 100).
# QO_MAX_USERS_PER_COMPANY=5
# Web: invitations a company may send per day (1 to 1000); more are answered the same but not sent.
# QO_INVITES_PER_DAY=20
# Web: invitations to one address per day, counted across all companies (1 to 100); more are
# answered the same but not sent.
# QO_INVITES_PER_ADDRESS_PER_DAY=3
# Web: drawing uploads (PRD section 6). MB per file (1 to 200), MB of drawings per company
# (1 to 100000) and jobs per calendar month in UTC (1 to 100000). One MB is 1048576 bytes.
# QO_MAX_FILE_MB=25
# QO_MAX_COMPANY_MB=500
# QO_MAX_JOBS_PER_MONTH=50
